rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only allow operations on the collections specifically used by SimpleScoringApp
    // Note: Since this app operates in unauthenticated/public mode for simplicity,
    // these rules restrict document schema boundaries to teams and matches.
    // For production multi-user deployments, Firebase Authentication and user-level
    // access controls should be added.

    match /teams/{teamId} {
      allow read, write: if true;
    }

    match /matches/{matchId} {
      allow read, write: if true;

      match /events/{eventId} {
        allow read, write: if true;
      }
    }

    // Deny access to any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
